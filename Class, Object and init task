class Movie:
  def __init__(self,movie_name,director,language,release_year):
    self.movie_name = movie_name
    self.director = director
    self.language = language
    self.release_year = release_year

movie_details = Movie("Avengers","Joss Whedon","English","2012")

print("Movie Name : ", movie_details.movie_name)
print("Director : ", movie_details.director)
print("Language : ", movie_details.language)
print("Release Year : ", movie_details.release_year)
