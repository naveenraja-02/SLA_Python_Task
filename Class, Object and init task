class Laptop:
  def __init__(self,brand,processor,RAM,storage):
    self.brand = brand
    self.processor = processor
    self.RAM = RAM
    self.storage = storage

obj = Laptop("Lenovo","Intel Ultra 5","16 GB","512 GD SSD")

print("Brand : ", obj.brand)
print("Processor : " , obj.processor)
print("RAM : " , obj.RAM)
print("Storage : " , obj.storage)

